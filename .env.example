# Optional LLM provider with an OpenAI-compatible tool-calling API.
# No provider calls occur unless all three are set in the server environment.
# Verify your provider's quota/pricing before enabling; no free usage is promised.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Free deployment: true prevents LLM calls even if credentials exist.
DISABLE_LLM=true

# Deployment-only public URL of the exact separately delivered model ZIP.
MODEL_PACKAGE_URL=
